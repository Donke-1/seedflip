# SeedFlip backend env. Copy to `.env` and edit. NEVER commit the real .env.

# --- Solana RPC ----------------------------------------------------------
# Public mainnet-beta is heavily rate-limited and will be too slow for
# autonomous trading. Get a free Helius / QuickNode / Triton key for
# production. Below is the public default (works for the test-swap).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Hard arming gate ----------------------------------------------------
# When false, /api/control/test-swap and /api/control/go-live both refuse.
# Set true ONLY when you are ready to move real funds.
LIVE_TRADING_ARMED=false

# --- Wallet keypair persistence ------------------------------------------
# Path inside the container. With docker-compose.yml's volume mount, this
# corresponds to ./data/wallet.json on the host. Permission 0600.
WALLET_SECRET_PATH=/data/wallet.json

# --- Bot risk knobs (rarely changed) -------------------------------------
# All defaults match the honest-backtest config (S1=30%/S2=70%/S3=0%).
SEED_USD=10
TARGET_USD=100
HORIZON_DAYS=7
DAILY_LOSS_CUTOFF_PCT=0.4
MAX_TRADE_PCT=0.4
DUST_FLOOR_USD=0.5
